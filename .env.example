# Backend-only secrets. Never add VITE_ to a secret variable.
NEBIUS_API_KEY=
CONTREE_BASE_URL=

# Sandbox is disabled by default. The smoke script requires explicit enablement.
SANDBOX_ENABLED=false
SANDBOX_IMAGE=python:3.12-slim

# Browser-facing API base URL; this is not a secret.
VITE_API_BASE_URL=http://127.0.0.1:8000
