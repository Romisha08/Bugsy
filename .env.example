# Backend-only secrets. Never add VITE_ to a secret variable.
NEBIUS_API_KEY=
CONTREE_BASE_URL=
CONTREE_PROJECT_ID=your-project-id-here  # Replace with your ConTree project ID

# Sandbox is disabled by default. The smoke script requires explicit enablement.
SANDBOX_ENABLED=false
TOKEN_FACTORY_ENABLED=false
SANDBOX_RETAIN_INSTALLATION_ARTIFACT=false

# Optional. Defaults to the system temporary directory (for example,
# /tmp/bugsy.sqlite3 on Render Free). Temporary storage is not durable.
# For a host-mounted persistent disk, set this to the database file path there.
# BUGSY_DATABASE_PATH=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Browser-facing API base URL; this is not a secret.
VITE_API_BASE_URL=http://127.0.0.1:8000
